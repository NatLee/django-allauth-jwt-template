# Copy to .env and adjust:  cp .env.example .env
# docker compose and manage.py both read it. Empty values mean "use the default".

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is off. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to send cookie-authenticated POSTs, e.g. https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# true when a reverse proxy in front of Django terminates HTTPS
DJANGO_BEHIND_PROXY=false
DJANGO_TIME_ZONE=Asia/Taipei

# ---------------------------------------------------------------------------
# Your frontend
# ---------------------------------------------------------------------------
# Empty: allauth's emails and error redirects go to the demo page.
# Set it when your own frontend lives elsewhere, e.g. https://app.example.com
FRONTEND_URL=
# A frontend on another origin that calls this API from the browser.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# optional (signed in right away, confirmation email sent) | mandatory | none
ACCOUNT_EMAIL_VERIFICATION=optional
# Only these email domains may sign up or link a third-party account; empty = any.
# The old template had gmail.com,hotmail.com built in.
ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# JWT (allauth's JWTTokenStrategy)
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=86400
# true: logging out ends the access token at once (one session lookup per request)
JWT_STATEFUL_VALIDATION=true
# HS256 signs with DJANGO_SECRET_KEY. For RS256 make a key:
#   openssl genpkey -algorithm RSA -out jwt.pem -pkeyopt rsa_keygen_bits:2048
# and put the PEM in JWT_PRIVATE_KEY (in double quotes, line breaks as \n).
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Third-party login
#
# A provider turns on when its client ID is set. Register this callback URL:
#   http://localhost:5566/api/allauth/<provider>/login/callback/
# ---------------------------------------------------------------------------

# A fake provider to try the flows without registering anything.
# Development only: Django refuses to start with it while DJANGO_DEBUG is off.
ENABLE_DUMMY_PROVIDER=true

# Google: https://console.cloud.google.com/apis/credentials (OAuth client ID, "Web application")
#   callback: http://localhost:5566/api/allauth/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft: https://entra.microsoft.com (App registrations, platform "Web")
#   callback: http://localhost:5566/api/allauth/microsoft/login/callback/
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common | organizations | consumers | your tenant ID
MS_TENANT=common

# LINE: https://developers.line.biz/console/ (LINE Login channel)
#   callback: http://localhost:5566/api/allauth/line/login/callback/
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email (printed to the server log unless you pick another backend)
# ---------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
